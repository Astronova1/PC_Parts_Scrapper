@using PC_Parts_Scrapper.ViewModels
@model List<ProductDisplayViewModel>


@{
    ViewData["Title"] = "CPU Price Tracker";
}

<div class="container mt-4">
    <h2 class="mb-4">CPU Market Prices</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            No products found in the database. Run the scraper first!
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var cpu in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title text-primary">@cpu.Name</h5>
                            <p class="card-text text-muted">Product ID: #@cpu.ProductId</p>

                            <h6 class="mt-3">Available Store Listings:</h6>

                            @if (!cpu.Listings.Any())
                            {
                                <p class="text-danger small">No active store listings recorded yet.</p>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush mt-2">
                                    @foreach (var store in cpu.Listings)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@store.StoreName</strong>
                                                @if (store.Url != null)
                                                {
                                                    <a href="@store.Url" target="_blank" class="ms-2 small text-decoration-none">
                                                        Visit Store ↗
                                                    </a>
                                                }
                                            </div>
                                            <span class="badge bg-success fs-6">
                                                Rs. @store.LatestPrice.ToString("N0")
                                            </span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>